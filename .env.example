# Environment variables for docker-compose
# Copy this file to .env and adjust values as needed

# Log level: debug, info, warn, error, fatal, panic
LOGLEVEL=info

# Number of concurrent downloads
WORKERS=2

# JSON formatted logs (useful for log aggregation)
JSON_LOG=false

# Optional: Date range filter (YYYY-MM-DD format)
# FROM_DATE=2024-01-01
# TO_DATE=2024-12-31

# Optional: Specific album ID to download
# ALBUM_ID=your_album_id_here

# Optional: Album type (album, sharing, favorites, etc.)
# ALBUM_TYPE=album
